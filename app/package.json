{
  "name": "clave-agent",
  "version": "0.1.1",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "start": "node scripts/build.mjs && CLAVE_STANDINS=1 electron .",
    "start:scripted": "node scripts/build.mjs && CLAVE_STANDINS=1 CLAVE_SCRIPTED_MODEL=1 electron .",
    "start:api": "node scripts/build.mjs && CLAVE_STANDINS=1 CLAVE_REAL_API=1 CLAVE_SCRIPTED_MODEL=1 electron .",
    "smoke": "node scripts/build.mjs && CLAVE_STANDINS=1 CLAVE_SCRIPTED_MODEL=1 CLAVE_SMOKE=1 CLAVE_DATA_DIR=\"$(mktemp -d)\" electron .",
    "eval:gate": "node scripts/build.mjs && node dist/eval-gate.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node scripts/build-native.mjs --test",
    "dev:bundle": "node scripts/build.mjs && node scripts/dev-bundle.mjs",
    "package:stage": "node scripts/package/stage.mjs",
    "package:bundle": "node scripts/package/bundle.mjs",
    "package:sign": "node scripts/package/sign.mjs",
    "package:artefacts": "node scripts/package/artefacts.mjs",
    "release": "bumpp --commit \"release v%s\" --tag \"v%s\" --push",
    "start:reader": "node scripts/build.mjs && node scripts/start-reader.mjs",
    "start:reader:scripted": "node scripts/build.mjs && node scripts/start-reader.mjs --scripted",
    "reader:eval": "node scripts/build.mjs && node scripts/reader-eval.mjs"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "bumpp": "12.3.0",
    "electron": "44.4.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
